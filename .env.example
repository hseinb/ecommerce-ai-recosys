# MSSQL Connection Configuration (Compatibility level 100 / SQL Server)
MSSQL_SERVER=localhost
MSSQL_INSTANCE=SQLEXPRESS
MSSQL_PORT=1433
MSSQL_DATABASE=InventoryDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourPasswordHere
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_ENCRYPT=no

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Model & Pipeline Parameters
EMBEDDING_DIM=64
ANN_TOP_K=20
SEASONAL_BOOST_ALPHA=0.3
SERVICE_LEVEL_Z=1.65
